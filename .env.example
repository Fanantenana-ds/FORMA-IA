# ============================================================
# FORMA-IA — ENVIRONNEMENT (DEV)
# ============================================================

# ── BASE DE DONNÉES ─────────────────────────────────────────
DATABASE_URL=CHANGE_ME

# ── SÉCURITÉ JWT ────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── COMPTES INTERNES ────────────────────────────────────────
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
BACKEND_SERVICE_EMAIL=CHANGE_ME
BACKEND_SERVICE_PASSWORD=CHANGE_ME

# ── CLÉ PARTAGÉE BACKEND ↔ IA ───────────────────────────────
# Utilisée pour authentifier les appels internes Backend → IA
# ET les appels IA → Backend (sync M1/M2)
# Même valeur dans les deux services (.env Backend ET .env IA)
SHARED_INTERNAL_TOKEN=CHANGE_ME

# ── LLM PROVIDER ────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=20
GROQ_MAX_OUTPUT_TOKENS=2500
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Claude (préparé pour V3, inactif en dev)
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── TAVILY ──────────────────────────────────────────────────
TAVILY_API_KEY=CHANGE_ME
TAVILY_MAX_RESULTS=15
TAVILY_TIMEOUT=8
TAVILY_INCLUDE_DOMAINS=asako.mg,job2mada.com,portaljob-madagascar.com,codeko.tech,optioncarriere.mg,emploi.mg,recrutement.mg,madagascar-internet.com,developa.net,facebook.com,linkedin.com,manda.mg,upwork.com,freelancer.com,indeed.com
TAVILY_EXCLUDE_DOMAINS=wikipedia.org,youtube.com,instagram.com,twitter.com,tiktok.com,amazon.com,ebay.com,pinterest.com
TAVILY_REJECTED_KEYWORDS=skincare,lotion,cosmetic,beauty,makeup,film,movie,trailer,cinema,hollywood,zoo,lemur,bitcoin,cryptocurrency,unicef
TAVILY_JOB_KEYWORDS=emploi,recrutement,offre,job,recrute,cdi,cdd,stage,freelance,mission,poste,développeur,developpeur,developer,engineer,technicien,analyste,data scientist,devops

# ── RAG / EMBEDDINGS ────────────────────────────────────────
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY_SOUTENANCE=CHANGE_ME
VOYAGE_API_KEY=CHANGE_ME
VOYAGE_MODEL_DOCUMENT=voyage-4-large
VOYAGE_MODEL_QUERY=voyage-4-large
VOYAGE_KEY_PROFILE=dev
VOYAGE_RPM=3
VOYAGE_TPM=10000
VOYAGE_OPT_OUT=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MIN_SCORE=0.41

# ── VEILLE AUTO (M1) ────────────────────────────────────────
VEILLE_AUTO_ENABLED=true
VEILLE_AUTO_INTERVAL_HOURS=6
VEILLE_AUTO_MAX_RUNS_PER_DAY=4
BACKEND_SYNC_ENABLED=true
BACKEND_API_URL=http://localhost:8000/api/v1

# ── SEUILS M1 ───────────────────────────────────────────────
MIN_SCORE_VALIDATED=15
MIN_SCORE_TO_REVIEW=5
MIN_CONFIDENCE_VALIDATED=0.10
MAX_RESULTS_AI=8
MAX_FALLBACK_BATCHES=2

# ── TDR (M2) ────────────────────────────────────────────────
TDR_MAX_OUTPUT_TOKENS=20000
TDR_TEMPERATURE=0.3

# ── LIMITES GÉNÉRALES ───────────────────────────────────────
MAX_PROMPT_CHARS=18000
MAX_SOURCE_CHARS_TOTAL=20000
MAX_SOURCE_CHARS_EACH=4000
RATE_LIMIT_PER_MINUTE=100
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# ── ENVIRONNEMENT ───────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=text
VERBOSE_LOGS=true

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000


# =============# Simulation (aucun appel Groq) :
# venv\Scripts\python.exe scripts/demo_pipeline.py --dry-run

# Démo réelle (5 appels Groq, ~50s) — à relancer après minuit UTC (quota renouvelé) :
# venv\Scripts\python.exe scripts/demo_pipeline.py
# ======================
# Une seule étape :
# venv\Scripts\python.exe scripts/demo_pipeline.py --etapes M1
# ── GOOGLE WORKSPACE ────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=CHANGE_ME
GOOGLE_DRIVE_FOLDER_ID=1AybvaCNzKhtpNOGxlGzClCC1btPTRIL1
GOOGLE_REFRESH_TOKEN=CHANGE_ME
# DWD : email de l'utilisateur Google Workspace à impersonner (domain-wide delegation)
# Laisser vide => le Service Account crée les formulaires en son propre nom
# Remplir => activer DWD dans Google Workspace Admin (voir docs/dwd_setup.md)
# GOOGLE_SUBJECT_EMAIL=admin@votre-domaine.com

# ── SMTP (Gmail via service account) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=ALTIORA PREST
SMTP_FROM=RH ALTIORA PREST <fanantenana7170@gmail.com>

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME
RH_EMAIL_POSTE_DEFAUT=CHANGE_ME

# Declenceur automatique EMAIL qui entre dans mon adresse email
RH_EMAIL_AUTO_ENABLED=true
RH_EMAIL_CHECK_INTERVAL_MINUTES=30


# -- STOCKAGE FICHIERS (supports de cours RAG) --------------------------------
#
# COMMENT CHANGER DE STOCKAGE EN PRODUCTION :
#   Changer UNE SEULE ligne : STORAGE_BACKEND=local  ?  STORAGE_BACKEND=gcs
#   Aucun autre fichier de code � modifier.
#
# STORAGE_BACKEND : backend de stockage actif
#   local  ? fichiers sur le disque du serveur dans data/rag/fichiers/
#             Recommand� au lancement (< 300 supports, < 10 formateurs actifs)
#   gcs    ? Google Cloud Storage (bucket GCP)
#             Recommand� en production quand > 300 supports ou > 8-10 Go
#             N�cessite GCS_BUCKET_NAME ci-dessous
#             Utilise automatiquement GOOGLE_CREDENTIALS_PATH (d�j� configur�)
STORAGE_BACKEND=local

# STORAGE_MAX_FILE_MB : taille maximale par fichier upload� (en Mo)
#   D�faut : 100 Mo
#   Formats accept�s : .pdf .docx .pptx .xlsx .txt .md
STORAGE_MAX_FILE_MB=100

# GCS_BUCKET_NAME : nom du bucket Google Cloud Storage
#   Laisser vide tant que STORAGE_BACKEND=local (non utilis�)
#   Quand vous passez � STORAGE_BACKEND=gcs :
#     1. Cr�er le bucket sur https://console.cloud.google.com/storage
#          Projet : forma-ia-510012
#          Nom : forma-ia-bucket  (ou autre nom de votre choix)
#          R�gion : europe-west1 (Paris) pour conformit� RGPD
#     2. Donner au Service Account (GOOGLE_CREDENTIALS_PATH) le r�le
#          "Storage Object Admin" sur ce bucket
#     3. Renseigner le nom ici et changer STORAGE_BACKEND=gcs
#   Co�t estim� : ~0.02 EUR/Go/mois ? 200 supports PDF � 0.20 EUR/mois
GCS_BUCKET_NAME=

# Frontend
VITE_API_URL=http://localhost:8000
