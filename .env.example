# ============================================================
# FORMA-IA — ENVIRONNEMENT (DEV) — EXEMPLE
# ============================================================
# Ce fichier est un TEMPLATE.
# 1. Copier : cp .env.example .env
# 2. Remplir les valeurs (jamais commit .env)
# ============================================================

# ── BASE DE DONNÉES ─────────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/formaia

# ── SÉCURITÉ JWT ────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── COMPTES INTERNES ────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BACKEND_SERVICE_EMAIL=sync-ia@example.com
BACKEND_SERVICE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── CLÉ PARTAGÉE BACKEND ↔ IA ───────────────────────────────
# Utilisée pour authentifier les appels internes Backend → IA
# ET les appels IA → Backend (sync M1/M2)
# Même valeur dans les deux services (.env Backend ET .env IA)
# Générer avec : openssl rand -hex 32
SHARED_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_HEX_CHARS

# ── LLM PROVIDER ────────────────────────────────────────────
# Options : groq | claude
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=20
GROQ_MAX_OUTPUT_TOKENS=2500
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Claude (préparé pour V3, inactif en dev)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── TAVILY (recherche web) ──────────────────────────────────
# https://app.tavily.com/home
TAVILY_API_KEY=tvly-dev-CHANGE_ME
TAVILY_MAX_RESULTS=15
TAVILY_TIMEOUT=8
TAVILY_INCLUDE_DOMAINS=asako.mg,job2mada.com,portaljob-madagascar.com,codeko.tech,optioncarriere.mg,emploi.mg,recrutement.mg,madagascar-internet.com,developa.net,facebook.com,linkedin.com,manda.mg,upwork.com,freelancer.com,indeed.com
TAVILY_EXCLUDE_DOMAINS=wikipedia.org,youtube.com,instagram.com,twitter.com,tiktok.com,amazon.com,ebay.com,pinterest.com
TAVILY_REJECTED_KEYWORDS=skincare,lotion,cosmetic,beauty,makeup,film,movie,trailer,cinema,hollywood,zoo,lemur,bitcoin,cryptocurrency,unicef
TAVILY_JOB_KEYWORDS=emploi,recrutement,offre,job,recrute,cdi,cdd,stage,freelance,mission,poste,développeur,developpeur,developer,engineer,technicien,analyste,data scientist,devops

# ── RAG / EMBEDDINGS ────────────────────────────────────────
# Options : voyage | fastembed (fallback local)
EMBEDDING_PROVIDER=voyage

# Voyage AI (https://dashboard.voyageai.com)
# ATTENTION : free tier = 3 RPM / 10K TPM
# Deux clés possibles : dev (usage courant) et soutenance (démo jury)
VOYAGE_API_KEY=pa-CHANGE_ME
VOYAGE_API_KEY_SOUTENANCE=pa-CHANGE_ME
VOYAGE_MODEL_DOCUMENT=voyage-4-large
VOYAGE_MODEL_QUERY=voyage-4-large
# Profil actif : dev | soutenance
VOYAGE_KEY_PROFILE=dev
VOYAGE_RPM=3
VOYAGE_TPM=10000
# true = désactiver l'entraînement Voyage sur vos données (recommandé, nécessite carte)
VOYAGE_OPT_OUT=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MIN_SCORE=0.41

# ── VEILLE AUTO (M1) ────────────────────────────────────────
VEILLE_AUTO_ENABLED=true
VEILLE_AUTO_INTERVAL_HOURS=6
VEILLE_AUTO_MAX_RUNS_PER_DAY=4
BACKEND_SYNC_ENABLED=true
BACKEND_API_URL=http://localhost:8000/api/v1

# ── SEUILS M1 ───────────────────────────────────────────────
MIN_SCORE_VALIDATED=15
MIN_SCORE_TO_REVIEW=5
MIN_CONFIDENCE_VALIDATED=0.10
MAX_RESULTS_AI=8
MAX_FALLBACK_BATCHES=2

# ── TDR (M2) ────────────────────────────────────────────────
TDR_MAX_OUTPUT_TOKENS=20000
TDR_TEMPERATURE=0.3

# ── LIMITES GÉNÉRALES ───────────────────────────────────────
MAX_PROMPT_CHARS=18000
MAX_SOURCE_CHARS_TOTAL=20000
MAX_SOURCE_CHARS_EACH=4000
RATE_LIMIT_PER_MINUTE=100
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# ── ENVIRONNEMENT ───────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
VERBOSE_LOGS=true

# ── CORS ────────────────────────────────────────────────────
# Séparer par virgule. En prod : retirer localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# ── GOOGLE WORKSPACE (Forms, Sheets, Drive) ─────────────────
# Chemin vers le Service Account (jamais commit le .json)
GOOGLE_CREDENTIALS_PATH=secrets/google_credentials.json
# ID du dossier Drive partagé avec le Service Account
GOOGLE_DRIVE_FOLDER_ID=CHANGE_ME_FOLDER_ID
# DWD : email de l'utilisateur Google Workspace à impersonner
# Voir docs/dwd_setup.md pour la configuration
# Laisser vide => le Service Account crée les formulaires en son propre nom
# GOOGLE_SUBJECT_EMAIL=admin@votre-domaine.com

# ── SMTP (Gmail via service account) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
# Utiliser un App Password Gmail (pas le mot de passe réel)
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_NAME=ALTIORA PREST

# ════════════════════════════════════════════════════════════
# NOTES DEV
# ════════════════════════════════════════════════════════════
# Simulation (aucun appel Groq) :
#   venv\Scripts\python.exe scripts/demo_pipeline.py --dry-run
#
# Démo réelle (5 appels Groq, ~50s) — relancer après minuit UTC :
#   venv\Scripts\python.exe scripts/demo_pipeline.py
#
# Une seule étape :
#   venv\Scripts\python.exe scripts/demo_pipeline.py --etapes M1