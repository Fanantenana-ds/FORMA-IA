# Variables d'environnement — PRODUCTION
# Ce fichier est un modèle. Les vraies valeurs de production ne sont jamais
# commitées. À dupliquer en .env.production (non versionné) lors du déploiement (S12).

DATABASE_URL=postgresql://<user>:<password>@<host_production>:5432/forma_ia_production
SECRET_KEY=<a_generer_uniquement_pour_la_production>
ANTHROPIC_API_KEY=<cle_production>
GROQ_API_KEY=<cle_production>
TAVILY_API_KEY=<cle_production>

# Frontend
VITE_API_URL=https://<domaine_production>

# Coordonnées légales de l'émetteur imprimées sur les factures PDF.
# Renseigner les informations officielles avant la mise en production.
INVOICE_ISSUER_NAME=ALTIORA PREST
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_RCS=
INVOICE_ISSUER_VAT=
INVOICE_ISSUER_EMAIL=
INVOICE_ISSUER_PHONE=
INVOICE_LATE_PENALTY_RATE=
INVOICE_RECOVERY_FEE=

# A ajouter quand l'integration Google sera prete (voir docs/integration-google.md)
# GOOGLE_APPLICATION_CREDENTIALS=<chemin_ou_variable>
