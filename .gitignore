# ============================================================
# FORMA-IA — .gitignore
# ============================================================

# Environnements virtuels
venv/
env/
.venv/

# Variables d'environnement — SÉCURITÉ
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
.pytest_cache/
.coverage
htmlcov/
.http

# IDE
.vscode/
.idea/
*.swp
*.swo

# Base de données
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Fichiers temporaires
*.tmp
*.temp
.DS_Store
Thumbs.db

# Docker
*.pid
*.socket
pgdata/

# Google / credentials
credentials.json
*.key

# Données
data/*.csv
data/*.xlsx

# Exports générés
exports/
dist/
build/
*.egg-info/
*.pdf
*.docx
*.xlsx

# Fichiers de test / temporaires du projet
test.http
formaia-backend.zip