# ═══════════════════════════════════════════════════════════════
# FORMA-IA — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 🔐 SECRETS — JAMAIS PUSH
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets/
credentials/
config/secrets.yaml

# ─────────────────────────────────────────────────────────────
# 🐍 PYTHON
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnements virtuels
venv/
env/
ENV/
.venv/
.env-*

# ─────────────────────────────────────────────────────────────
# 🧪 TESTS & CACHE
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# ─────────────────────────────────────────────────────────────
# 📁 OUTPUTS & DATA (fichiers générés)
# ─────────────────────────────────────────────────────────────
outputs/
exports/
data/
logs/
*.log
*.out

# Attestations PDF générées (mais garder le template)
exports/attestations/*.pdf
exports/rapports/*.pdf
exports/rapports/*.docx

# TDR générés
exports/tdr/*.pdf
exports/tdr/*.docx

# HITL reviews (fichier de persistance local)
data/hitl_reviews.json

# ─────────────────────────────────────────────────────────────
# 💾 BASES DE DONNÉES LOCALES
# ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump

# ─────────────────────────────────────────────────────────────
# 🎨 IDE / ÉDITEURS
# ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ─────────────────────────────────────────────────────────────
# 🖥️ OS
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# 📦 NODE (si frontend dans le repo)
# ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# 📊 JUPYTER
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# 📝 TEMPORAIRES
# ─────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*~
.cache/
# Fichiers de test / temporaires du projet
test.http
formaia-backend.zip