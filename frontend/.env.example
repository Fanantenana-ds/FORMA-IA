# URL de base du backend FORMA-IA (sans slash final, sans /api/v1).
# Copiez ce fichier en `.env` puis adaptez la valeur à votre environnement.
VITE_API_URL=http://127.0.0.1:8000

# Jeton interne pour les routes /api/v1/ia/* (fourni par l'équipe backend).
# À conserver dans .env.local en développement, jamais dans un dépôt public.
VITE_IA_TOKEN=
